# ExhibitKIT local / preview environment.
# Copy to `.env.local`. Never commit real values from the server-only section.

# Public Stripe-hosted Payment Link. No Stripe secret key belongs in this Vite app.
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/dRm4gze2Ob4c4NF3mKg7e01

# Same-origin Vercel license service. Leave blank to use /api/license.
VITE_LICENSE_API_URL=/api/license

# Optional. Enables founder admin in production/preview builds (baked into the
# client bundle — not real server auth). Leave unset to keep the console off
# in non-DEV builds. Local DEV uses ekit-founder-2026 when this is empty.
# VITE_FOUNDER_ADMIN_SECRET=

# ---------------------------------------------------------------------------
# SERVER ONLY — set these in Vercel, never with a VITE_ prefix.
# ---------------------------------------------------------------------------
APP_URL=https://exhibitkit.patentpreppers.com
SUPPORT_EMAIL=support@patentpreppers.com
DATABASE_URL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

RESEND_API_KEY=
LICENSE_EMAIL_FROM="ExhibitKIT <licenses@patentpreppers.com>"

# Generate these with: npm run license:secrets
LICENSE_HASH_SECRET=
RATE_LIMIT_HASH_SECRET=
LICENSE_ENCRYPTION_KEY=

# One transfer per 24 hours by default. Set 0 while testing.
LICENSE_TRANSFER_COOLDOWN_HOURS=24
EXHIBITKIT_VERSION=v0.10.0
