# ExhibitKit local / preview environment.
# Copy to `.env.local`. Never commit real values from the server-only section.

# Public Stripe-hosted Payment Links. No Stripe secret key belongs in this Vite app.
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/dRm4gze2Ob4c4NF3mKg7e01
VITE_STRIPE_PRO_LINK=
VITE_STRIPE_CASE_PASS_LINK=

# Same-origin Vercel license service. Leave blank to use /api/license.
VITE_LICENSE_API_URL=/api/license

# Optional local DEV override for founder admin. Never set this in Vercel —
# Vite would bake it into the client bundle. There is no built-in default.
# Production uses server-only FOUNDER_ADMIN_SECRET (see docs/FOUNDER_ADMIN.md).
# VITE_FOUNDER_ADMIN_SECRET=

# Ed25519 public key (32 bytes, base64) from `npm run license:secrets`.
# Required at build time so the browser can verify license and founder tokens.
# This is not a secret. It must be the pair of ENTITLEMENT_SIGNING_KEY.
# Production builds fail when this is missing or not 32 bytes.
# VITE_ENTITLEMENT_PUBLIC_KEY=
# Optional key id for this public key. Defaults to "current".
# VITE_ENTITLEMENT_PUBLIC_KEY_ID=current
# Optional JSON object of older key ids to public keys, so tokens still verify during rotation.
# VITE_ENTITLEMENT_ADDITIONAL_PUBLIC_KEYS={"previous":"..."}

# ---------------------------------------------------------------------------
# SERVER ONLY — set these in Vercel, never with a VITE_ prefix.
# ---------------------------------------------------------------------------
# Optional. Enables founder unlock on production via POST /api/founder/unlock.
# At least 32 characters. Do not reuse a default, example, or test placeholder.
# FOUNDER_ADMIN_SECRET=

# Ed25519 private seed (32 bytes, base64) from `npm run license:secrets`.
# Server only. Signs license entitlements and founder unlock tokens.
# Never use a VITE_ prefix. Pair it with VITE_ENTITLEMENT_PUBLIC_KEY above.
# ENTITLEMENT_SIGNING_KEY=
# Optional id written into new tokens. Defaults to "current". Set the matching
# VITE_ENTITLEMENT_PUBLIC_KEY_ID, and keep the previous public key in
# VITE_ENTITLEMENT_ADDITIONAL_PUBLIC_KEYS until older tokens expire.
# ENTITLEMENT_SIGNING_KEY_ID=current

APP_URL=https://exhibitkit.patentpreppers.com
SUPPORT_EMAIL=support@patentpreppers.com
DATABASE_URL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Optional additional Stripe price IDs when Case Pass / update renewal products exist
# STRIPE_PRICE_CASE_PASS=
# STRIPE_PRICE_PRO_PERPETUAL=
# STRIPE_PRICE_PRO_UPDATES=

RESEND_API_KEY=
LICENSE_EMAIL_FROM="ExhibitKit <licenses@patentpreppers.com>"

# Generate these, plus the entitlement signing keypair, with: npm run license:secrets
LICENSE_HASH_SECRET=
RATE_LIMIT_HASH_SECRET=
LICENSE_ENCRYPTION_KEY=

# One transfer per 24 hours by default. Set 0 while testing.
LICENSE_TRANSFER_COOLDOWN_HOURS=24
EXHIBITKIT_VERSION=v1.0.0
