# ExhibitKit environment variables (names only — never commit secrets)
# Copy to .env.local for local development.

# Stripe Payment Links (Checkout hosted by Stripe)
# Create separate Payment Links in Stripe Dashboard for each product.
VITE_STRIPE_CASE_PASS_LINK=
VITE_STRIPE_PRO_LINK=

# Backward-compatible alias for the Pro perpetual Payment Link
VITE_STRIPE_PAYMENT_LINK=

# --- Production hardening (server-side; not used by the static Vite SPA yet) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_CASE_PASS=
# STRIPE_PRICE_PRO_PERPETUAL=
# STRIPE_PRICE_PRO_UPDATES=
# LICENSE_SIGNING_SECRET=
