# ExhibitKIT local / preview environment
# Copy to `.env.local` for Vite (never commit secrets that unlock production founder admin).

# Founder live-test console secret.
# Defaults to ekit-founder-2026 when unset. Set a custom value on public hosts.
VITE_FOUNDER_ADMIN_SECRET=ekit-founder-2026

# Public Stripe-hosted Payment Link. No Stripe secret key belongs in this Vite app.
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/replace_with_your_payment_link

# Future server-side checkout and entitlement services (see docs/BILLING_BACKEND.md).
# VITE_CHECKOUT_API_URL=
# VITE_ENTITLEMENT_API_URL=
# VITE_STRIPE_PRICE_CASE_PASS=
# VITE_STRIPE_PRICE_PRO=

# Future server-side license verification endpoint. Do not enable until the
# endpoint verifies Stripe fulfillment and returns signed activation data.
VITE_LICENSE_VALIDATION_URL=
